{
  "expo": {
    "name": "Segundo Cérebro",
    "slug": "segundo-cerebro",
    "version": "0.1.0",
    "scheme": "segundocerebro",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.segundocerebro"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0f",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "br.com.segundocerebro"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    }
  }
}
