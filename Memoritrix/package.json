{
  "name": "memoritrix",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -b packages/shared apps/api",
    "build": "CI=1 npm run export:web -w @cerebro/app",
    "start": "npm start -w @cerebro/api",
    "dev": "bash scripts/dev.sh",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
